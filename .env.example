# Public Supabase browser configuration. Publishable key is safe to expose with RLS enabled.
VITE_SUPABASE_URL=https://rsexflnlwxkgdkdzufmw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_3Xd4AsWM7rrilkk48AKdBA_G-GdkFU3

# Server only. Never put provider keys in VITE_* variables.
PORT=8787
CLIENT_ORIGIN=http://localhost:5173

# Venice
VENICE_API_KEY=
VENICE_IMAGE_MODEL=z-image-turbo
VENICE_MODERATION=auto

# Replicate: configure a model you have permission to use.
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=
REPLICATE_MODEL_NAME=
# Optional model-specific JSON inputs. The server enforces num_outputs=1.
REPLICATE_EXTRA_INPUT_JSON={}
# Optional input field key for reference-image URLs when the selected model supports it.
REPLICATE_REFERENCE_INPUT_KEY=
# Optional full pinned model version hash.
REPLICATE_MODEL_VERSION=
