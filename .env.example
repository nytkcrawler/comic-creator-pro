# Browser Supabase settings. Publishable keys are safe to expose in the frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server Supabase settings. The publishable key is public; user JWTs are verified per request.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

PORT=8787

# OpenAI Responses API. Keep this server-side; never use a VITE_ prefix.
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=gpt-5.5

# Venice
VENICE_API_KEY=
VENICE_IMAGE_MODEL=z-image-turbo
VENICE_MODERATION=auto

# Replicate: configure a model you have permission to use.
REPLICATE_API_TOKEN=
REPLICATE_MODEL_OWNER=
REPLICATE_MODEL_NAME=
REPLICATE_EXTRA_INPUT_JSON={}
REPLICATE_REFERENCE_INPUT_KEY=
REPLICATE_MODEL_VERSION=
